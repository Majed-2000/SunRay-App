# PRODUCTION environment example for the Sun Ray backend.
# Copy to your secret manager / deployment env — do NOT commit a filled-in copy.
#
# Key difference from development: the database is PostgreSQL with AUTHENTICATED
# credentials. SQLite has no user/password authentication and is single-file —
# it is for local development only and must never be used in production.

NODE_ENV=production
PORT=4000

# PostgreSQL with username:password@host. Use a strong DB password and restrict
# network access to the database (private network / security groups).
# prisma/schema.prisma's datasource provider must be set to "postgresql".
DATABASE_URL="postgresql://sunray:STRONG_DB_PASSWORD@db.internal:5432/sunray?schema=public&sslmode=require"

# A strong, unique signing secret (NOT the dev default — the server won't boot
# in production if this is left at the development value).
JWT_ACCESS_SECRET="REPLACE_WITH_64+_RANDOM_BYTES_BASE64URL"
ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
# Keep dev/admin override endpoints OFF in production unless you truly need them.
ADMIN_ENABLED=false

# Restrict CORS to your real web origins (comma-separated). The mobile app sends
# no Origin header and is unaffected.
CORS_ORIGINS=https://app.sunray.example,https://sunray.example

BODY_LIMIT=100kb
# Set to the number of proxy hops in front of the app (e.g. 1 behind a single LB)
# so rate-limiting sees the real client IP and X-Forwarded-For can't be spoofed.
TRUST_PROXY=1
