{
  "expo": {
    "name": "Sun Ray",
    "slug": "sun-ray-cafe",
    "scheme": "sunray",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/sunray-logo-icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#efe6d6",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#efe6d6",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sunray.cafe",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sunray.cafe",
      "adaptiveIcon": {
        "backgroundColor": "#efe6d6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "navigationBar": {
        "backgroundColor": "#efe6d6",
        "barStyle": "dark-content"
      },
      "versionCode": 15,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#efe6d6"
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/withAndroidAbiFilters",
      "./plugins/withAndroidDataBinding",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "نستخدم موقعك فقط عندما تطلبه بنفسك: عند ضغطك «وصلت» في خدمة السيارة، أو لإيجاد أقرب فرع، أو لتحديد موقع مناسبة الكاترينق.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "نستخدم الكاميرا فقط لمسح باركود الكاشير ومتابعة طلبك. لا نصوّر ولا نحفظ أي صورة.",
          "microphonePermission": "التطبيق لا يسجّل الصوت ولا يطلب الميكروفون؛ هذا النص مطلوب تقنيًا فقط.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
