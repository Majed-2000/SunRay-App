# Copy to `.env`. Expo inlines EXPO_PUBLIC_* vars at build time, so they end up
# inside the app — never put a secret here.
#
# The app talks to Firebase (project `sunray-xx`); its config is in
# src/services/firebase.ts, not here.

# Host of the public legal pages (/privacy, /terms). Both stores record these
# URLs, so this must be a stable domain. See src/constants/legal.ts.
EXPO_PUBLIC_API_BASE_URL=https://sunraycafe.duckdns.org
