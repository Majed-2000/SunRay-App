# Production secrets for the VPS stack.
#
# On the server:  cp prod.env.example .env  &&  nano .env
# The filename MUST be exactly `.env` — docker compose reads it for both
# ${...} substitution and for injecting values into the containers.
#
# NEVER commit the filled-in .env (deploy/.gitignore blocks it).

# ── Public hostname ──────────────────────────────────────────────────────────
# The domain that points at this server's public IP. Caddy issues the TLS
# certificate for exactly this name, so it must resolve BEFORE you start the
# stack — otherwise certificate issuance fails.
DOMAIN=api.sunray.sa

# Where Let's Encrypt sends certificate-expiry warnings if renewal breaks.
ACME_EMAIL=you@sunray.sa

# ── Database ─────────────────────────────────────────────────────────────────
# Generate a URL-safe password (no @ : / ? # characters — they break the
# DATABASE_URL that compose builds from this value):
#   openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
POSTGRES_PASSWORD=REPLACE_ME

# ── App secrets ──────────────────────────────────────────────────────────────
# Signs the short-lived access tokens. The server refuses to boot in production
# if this is left at the development default. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# or, if node isn't installed on the server:
#   openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
JWT_ACCESS_SECRET=REPLACE_ME

ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# ── CORS ─────────────────────────────────────────────────────────────────────
# Leave EMPTY for the mobile app (React Native sends no Origin header).
# Only set this if you later add a browser client, e.g.:
#   CORS_ORIGINS=https://admin.example.com
CORS_ORIGINS=
