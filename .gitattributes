# Files that are executed on Linux servers MUST keep LF line endings.
# With core.autocrlf=true (the Windows default) git would otherwise hand you
# CRLF copies, and bash fails on those with errors like:
#   /usr/bin/env: 'bash\r': No such file or directory
#
# These rules pin LF in the working copy too, so `scp`-ing a script straight
# from Windows to the server works.

*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Dockerfile  text eol=lf
Caddyfile   text eol=lf
.env*       text eol=lf
*.example   text eol=lf
