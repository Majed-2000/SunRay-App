# Copy this file to ".env" and adjust if needed:  cp .env.example .env
# Real secrets (API tokens, payment keys, Foodics token) live ONLY here on the
# server — never in the mobile app (EXPO_PUBLIC_* values get bundled into the app).

# Which environment we're in: development | production | test
NODE_ENV=development

# The port the backend listens on (the app will call http://<host>:4000)
PORT=4000

# Database connection. For local development we use a single SQLite file.
# PRODUCTION: use PostgreSQL with authenticated credentials (see .env.production.example).
# (For SQLite the path is relative to the prisma/ folder, so this is prisma/dev.db.)
DATABASE_URL="file:./dev.db"

# ── Auth / tokens ────────────────────────────────────────────────────────────
# HMAC secret used to sign access JWTs. A dev default is used if unset, but the
# server REFUSES TO START in production unless you set a strong, unique value.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-insecure-secret-change-me
# Access-token lifetime (jsonwebtoken duration string): 15m, 1h, ...
ACCESS_TTL=15m
# Refresh-token lifetime in days.
REFRESH_TTL_DAYS=30
# Allow dev/admin-only endpoints (e.g. PATCH /orders/:id/status) outside development.
ADMIN_ENABLED=false

# ── HTTP / security middleware ───────────────────────────────────────────────
# Comma-separated browser origin allowlist for CORS. Empty = reflect any origin
# (fine for local dev). In production set this to your web origins.
CORS_ORIGINS=
# Max JSON request body size.
BODY_LIMIT=100kb
# Number of proxy hops to trust for the real client IP (used by rate limiting).
# 0 in local dev. Behind one reverse proxy/load balancer, set this to 1.
TRUST_PROXY=0
