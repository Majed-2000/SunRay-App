# Copy to `.env` and fill in when a backend exists. Expo inlines EXPO_PUBLIC_* vars.
# The app talks ONLY to our own backend. The Foodics OAuth token lives on the
# backend (never in the app); Foodics endpoints are proxied under `${API_BASE_URL}/foodics/*`.

# Base URL of our backend (REST). Foodics proxy routes live here under /foodics/*.
EXPO_PUBLIC_API_BASE_URL=

# NOTE: Do NOT add a Foodics token, client_secret, or any secret here — these are
# EXPO_PUBLIC_* and get bundled into the app. Keep all secrets on the backend.
