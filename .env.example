# Copy to `.env` and fill in when you want to use the backend. Expo inlines
# EXPO_PUBLIC_* vars at build time. The app talks ONLY to our own backend — the
# Foodics token and other secrets live on the backend, never in the app.

# Base URL of our backend (the project in /backend).
# Local backend runs at http://localhost:4000. IMPORTANT: on a real phone via
# Expo Go, "localhost" means the PHONE, not your PC — use your PC's LAN IP
# (e.g. http://192.168.1.8:4000) or a tunnel when you wire it up.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# Feature flag. Keep "false" for now: the app stays on mock data and never calls
# the backend. Set to "true" (with a reachable URL above) in a later phase to
# switch screens over to the real backend.
EXPO_PUBLIC_USE_BACKEND=false

# NOTE: Do NOT add a Foodics token, client_secret, or any secret here — these are
# EXPO_PUBLIC_* and get bundled into the app. Keep all secrets on the backend.
