# Copy this file to ".env" and adjust if needed:  cp .env.example .env
# These are NOT secrets for this learning phase, but real secrets (API tokens,
# payment keys, Foodics token) will live ONLY here on the server later — never in
# the mobile app.

# Which environment we're in: development | production
NODE_ENV=development

# The port the backend listens on (the app will call http://<host>:4000)
PORT=4000

# Database connection. For local learning we use a single SQLite file.
# To move to PostgreSQL later, change the provider in prisma/schema.prisma and
# set this to a postgresql:// URL instead.
# (For SQLite the path is relative to the prisma/ folder, so this is prisma/dev.db.)
DATABASE_URL="file:./dev.db"
